{
  "name": "spoon",
  "productName": "Spoon",
  "version": "0.30.3",
  "description": "A Fork-style git client with a scalable, modern UI",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "electron scripts/render-icon.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac dir",
    "install:mac": "npm run dist:mac && sh scripts/install-mac.sh",
    "keygen": "node scripts/keygen.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "author": "Sokratis Vogiatzakis",
  "build": {
    "appId": "com.sokratis.spoon",
    "productName": "Spoon",
    "copyright": "© 2026 Sokratis Vogiatzakis",
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "artifactName": "Spoon-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Spoon-${version}-win-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spoon",
      "deleteAppDataOnUninstall": false
    }
  }
}
